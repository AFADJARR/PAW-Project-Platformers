<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between">

    <div class="max-w-4xl mx-auto p-6 w-full">
        <header class="mb-8 text-center border-b border-slate-800 pb-6">
            <span class="bg-emerald-500/10 text-emerald-400 text-xs font-semibold px-3 py-1 rounded-full border border-emerald-500/20">v1.0 / Draft - Cbot Plat</span>
            <h1 class="text-3xl font-extrabold tracking-tight text-white mt-3"><%= title %></h1>
            <p class="text-slate-400 text-sm mt-1">Otomatisasi pemesanan plat nomor custom & cek status 24/7</p>
        </header>

        <main class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-slate-900 rounded-xl shadow-lg p-6 border border-slate-800">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-lg font-bold text-slate-200">Katalog Varian Plat</h2>
                    <a href="/api/produk" target="_blank" class="text-xs bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-1.5 rounded-lg font-medium transition">
                        API JSON &rarr;
                    </a>
                </div>
                <div class="space-y-3">
                    <% products.forEach(product => { %>
                        <div class="bg-slate-950/60 p-3.5 rounded-lg border <%= product.isAvailable ? 'border-slate-800' : 'border-rose-900/50 bg-rose-950/10' %> flex justify-between items-center">
                            <div>
                                <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-300"><%= product.category %></span>
                                <h3 class="text-sm font-bold text-white mt-1"><%= product.material %></h3>
                                <p class="text-emerald-400 text-xs font-mono font-medium mt-0.5">Rp <%= product.price.toLocaleString('id-ID') %></p>
                            </div>
                            <div>
                                <% if (product.isAvailable) { %>
                                    <span class="text-[10px] bg-emerald-950 text-emerald-400 px-2 py-1 rounded border border-emerald-800">Tersedia</span>
                                <% } else { %>
                                    <span class="text-[10px] bg-rose-950 text-rose-400 px-2 py-1 rounded border border-rose-800">Habis</span>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="bg-slate-900 rounded-xl shadow-lg p-6 border border-slate-800 flex flex-col justify-between">
                <div>
                    <h2 class="text-lg font-bold text-slate-200 mb-4">Simulasi Platformers Menu</h2>
                    <div class="bg-slate-950 p-4 rounded-lg border border-slate-800 space-y-3 text-sm">
                        <div class="bg-slate-800/60 p-3 rounded-r-xl rounded-bl-xl text-slate-300 max-w-[85%]">
                            Halo! Selamat datang di Platformers. Silakan pilih jenis kendaraan Anda:
                        </div>
                        <div class="flex gap-2 mt-2">
                            <span class="bg-indigo-600 text-white text-xs px-3 py-1.5 rounded-full font-medium"> Mobil</span>
                            <span class="bg-indigo-600 text-white text-xs px-3 py-1.5 rounded-full font-medium"> Motor</span>
                        </div>
                    </div>
                </div>
                <div class="mt-4 text-xs text-slate-500 text-center">
                    Developer: <%= author %>
                </div>
            </div>
        </main>
    </div>

    <%- include('partials/footer') %>

</body>
</html>